# Variables d'environnement TOPilot
# https://app.supabase.com/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=your-project-url

# Clé publique (anon ou publishable — les deux noms sont acceptés par l'app)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Serveur uniquement — jamais exposée côté client (Vault, admin, must_change_password)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cron Vercel — Authorization: Bearer <CRON_SECRET> sur /api/cron/exchange-rates
CRON_SECRET=your-random-secret

# Origine publique de l'app (liens d'invitation Auth). En local : http://localhost:3000
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Migration one-shot Vault depuis Top10CRM (scripts/migrate-vault-secrets.ts) — optionnel
# Si absents, le script lit automatiquement ../top10crm/.env
# V1_SUPABASE_URL=https://your-top10crm-project.supabase.co
# V1_SUPABASE_SERVICE_ROLE_KEY=your-top10crm-service-role-key


NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
